CURSOR_API_KEY=cursor_your-key-here
CURSOR_WRITER_MODEL=gpt-5.6-sol
CURSOR_CHECKER_MODEL=claude-4.5-sonnet
CURSOR_ESCALATION_MODEL=claude-opus-5

# Direct providers (preferred). Cursor is the fallback when these keys are unset.
OPENAI_API_KEY=
OPENAI_WRITER_MODEL=gpt-4.1
ANTHROPIC_API_KEY=
ANTHROPIC_CHECKER_MODEL=claude-sonnet-4-5
ANTHROPIC_ESCALATION_MODEL=claude-opus-4-1
# Optional force: openai | anthropic | cursor
LLM_PROVIDER=

# Notion: create an internal integration at https://www.notion.so/my-integrations
# Prefer pointing NOTION_DATABASE_ID at your existing Job Applications database URL/ID.
# Or share a blank parent page and run: python -m jobapps setup-notion
NOTION_TOKEN=ntn_your-token-here
NOTION_PARENT_PAGE_ID=
NOTION_DATABASE_ID=
NOTION_MANUAL_DATABASE_ID=
