CURSOR_API_KEY=cursor_your-key-here
CURSOR_WRITER_MODEL=gpt-5.6-sol
CURSOR_CHECKER_MODEL=claude-4.5-sonnet
CURSOR_ESCALATION_MODEL=claude-opus-5

# Direct providers. Cursor is the fallback when these keys are unset.
OPENAI_API_KEY=
# Required when LLM_PROVIDER=openai or OPENAI_API_KEY is set. No silent model default.
OPENAI_WRITER_MODEL=gpt-4.1
OPENAI_REVIEWER_MODEL=gpt-4.1-mini
OPENAI_REPAIR_MODEL=gpt-4.1-mini
OPENAI_ESCALATION_MODEL=gpt-4.1

ANTHROPIC_API_KEY=
ANTHROPIC_CHECKER_MODEL=claude-sonnet-4-5
ANTHROPIC_ESCALATION_MODEL=claude-opus-4-1

# Optional force for all calls: openai | anthropic | cursor
LLM_PROVIDER=
# Optional override for review only (cheap checker / strong escalation still use the models above)
LLM_REVIEWER_PROVIDER=

# Provider retries apply only to rate limits and transient 5xx. Timeouts do not restart the job.
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_SECONDS=1
# Optional daily spend cap in USD. Empty = unlimited.
LLM_DAILY_BUDGET_USD=

# Notion: create an internal integration at https://www.notion.so/my-integrations
# Prefer pointing NOTION_DATABASE_ID at your existing Job Applications database URL/ID.
# Or share a blank parent page and run: python -m jobapps setup-notion
NOTION_TOKEN=ntn_your-token-here
NOTION_PARENT_PAGE_ID=
NOTION_DATABASE_ID=
NOTION_MANUAL_DATABASE_ID=
